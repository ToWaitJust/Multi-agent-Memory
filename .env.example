# ============================================================
# 环境变量模板（安全，可提交到 GitHub）
# 复制为 .env 并填入真实密钥（.env 已被 gitignore 排除）
# ============================================================

# Embedding API（项目配置为 DashScope text-embedding-v4）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# LLM API
# 不配 LLM key 时 app_dashboard.py:169 会自动降级到 DASHSCOPE_API_KEY 跑 qwen-plus，
# 功能完整（先验+回答都是真实调用），只是模型不同。
#
# DeepSeek 注意（D-060 实测，别照抄旧文档）：
#   ·模型名只有 deepseek-flash / deepseek-v4-pro，"deepseek-v4-flash" 会 HTTP 400
#   · 关思考必须用thinking={"type":"disabled"}（OpenAI SDK 里放extra_body）；
#     DeepSeek 收到 qwen 的 thinking_enable 会**静默忽略**，思考 token 吃光
#     max_tokens 导致 content 为空串。适配器已按后端自动区分，勿手工传参。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
